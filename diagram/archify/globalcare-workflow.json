  "nodes": [
    { "id": "user", "lane": "channel", "col": 0, "type": "external", "label": "用户", "sublabel": "描述售后问题", "width": 132 },
    { "id": "chat", "lane": "channel", "col": 1, "type": "frontend", "label": "Vue Chat", "sublabel": "消息 + SSE", "width": 132 },
    { "id": "response", "lane": "channel", "col": 5, "type": "backend", "label": "客服回复", "sublabel": "答案 / 引用 / 草稿", "width": 138 },
    { "id": "classify", "lane": "agent", "col": 2, "type": "backend", "label": "识别意图", "sublabel": "结构化路由", "tag": "LangChain", "width": 138 },
    { "id": "route", "lane": "agent", "col": 3, "type": "backend", "label": "选择路径", "sublabel": "FAQ / 故障 / 进度 / 维修", "tag": "LangGraph", "width": 148 },
    { "id": "policy", "lane": "evidence", "col": 3, "type": "database", "label": "检索政策", "sublabel": "market 过滤 + 引用", "width": 148 },
    { "id": "status_tool", "lane": "channel", "col": 4, "type": "messagebus", "label": "查询维修状态", "sublabel": "MCP 只读", "width": 148 },
    { "id": "business", "lane": "evidence", "col": 4, "type": "messagebus", "label": "查询订单设备", "sublabel": "MCP 只读事实", "width": 148 },
    { "id": "validate", "lane": "outcome", "col": 4, "type": "security", "label": "校验草稿", "sublabel": "字段 + 证据 + 事实", "tag": "Fail closed", "width": 148 },
    { "id": "draft", "lane": "outcome", "col": 5, "type": "backend", "label": "保存 Case Draft", "sublabel": "应用节点写入", "tag": "幂等", "width": 148 },
    { "id": "human_required", "lane": "evidence", "col": 5, "type": "external", "label": "human_required", "sublabel": "停止确定性承诺", "width": 148 }

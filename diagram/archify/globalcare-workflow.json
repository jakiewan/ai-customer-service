        "note": "展示从用户消息到 Case Draft 的完整受控链路。"
      },
      {
        "id": "self-service",
        "label": "自助回答分支",
        "focus": ["route", "policy", "status_tool", "response"],
        "note": "FAQ、故障排查和维修进度直接返回，不重复创建草稿。"
      },
      {
        "id": "safety-stop",
        "label": "证据与安全门",
        "focus": ["policy", "business", "validate", "human_required"],
        "note": "缺少可靠证据、业务冲突或草稿校验失败时停止确定性处理。"
      }
    ]
  },
  "lanes": [
    { "id": "channel", "label": "用户与 API" },
    { "id": "agent", "label": "LangGraph Agent" },
    { "id": "evidence", "label": "政策与业务工具" },
    { "id": "outcome", "label": "结果与安全门", "variant": "exception" }
  ],
  "phases": [
    { "id": "intake", "label": "接入与理解", "fromCol": 0, "toCol": 2 },
    { "id": "evidence_phase", "label": "证据与事实", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "commit_phase", "label": "校验与结果", "fromCol": 5, "toCol": 5, "variant": "security" }
  ],
  "groups": [
    { "id": "agent_loop", "label": "意图路由", "lane": "agent", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "evidence_loop", "label": "政策 / 业务证据", "lane": "evidence", "fromCol": 3, "toCol": 4, "variant": "dashed" },

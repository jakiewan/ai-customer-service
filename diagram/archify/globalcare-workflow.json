    { "id": "route-policy", "from": "route", "to": "policy", "label": "FAQ / 故障 / 维修", "variant": "default" },
    { "id": "route-status", "from": "route", "to": "status_tool", "label": "维修进度", "variant": "dashed", "role": "branch" },
    { "id": "route-response", "from": "route", "to": "response", "label": "一般咨询", "variant": "dashed", "role": "branch" },
    { "id": "policy-business", "from": "policy", "to": "business", "label": "CASE_REQUEST", "variant": "emphasis" },
    { "id": "policy-response", "from": "policy", "to": "response", "label": "政策证据 + 排查建议", "variant": "dashed", "role": "return" },
    { "id": "status-response", "from": "status_tool", "to": "response", "label": "confirmed status", "variant": "dashed", "role": "return" },
    { "id": "business-validate", "from": "business", "to": "validate", "label": "订单 / 设备事实", "variant": "emphasis" },
    { "id": "validate-draft", "from": "validate", "to": "draft", "label": "valid", "variant": "security" },
    { "id": "validate-human", "from": "validate", "to": "human_required", "label": "evidence missing", "variant": "security", "role": "error" },
    { "id": "policy-human", "from": "policy", "to": "human_required", "label": "no reliable policy", "variant": "security", "role": "error" },
    { "id": "business-human", "from": "business", "to": "human_required", "label": "tool / market conflict", "variant": "security", "role": "error" },
    { "id": "draft-response", "from": "draft", "to": "response", "label": "DRAFT_CREATED", "variant": "emphasis", "role": "return" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "意图分层",
      "items": [
        "FAQ 与无法开机优先返回政策依据和可操作排查建议",
        "维修进度直接调用只读工具，不创建第二份草稿",
        "申请维修才进入订单事实、草稿构建和校验路径"
      ]
    },
    {
      "dot": "emerald",
      "title": "证据门禁",
      "items": [
        "政策检索按购买市场过滤并保留引用",
        "订单所属市场与请求市场冲突时停止处理",
        "草稿字段、政策证据和业务事实齐全后才允许写入"
      ]
    },
    {
      "dot": "rose",
      "title": "失败闭环",
      "items": [
        "无依据、工具不可用或校验失败统一返回 human_required",
        "Case Draft 是 Agent 侧终点，不代表正式 Case 或 Work Order",
        "同一会话已有草稿时走复用逻辑，避免重复创建"
      ]
    }
  ]

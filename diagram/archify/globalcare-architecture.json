  "cards": [
    {
      "dot": "cyan",
      "title": "请求主链",
      "items": [
        "Vue 3 只负责聊天展示，FastAPI 提供 REST 与 SSE",
        "LangGraph 以 conversation_id 作为 thread_id 保存跨轮状态",
        "回复包含政策引用、工具事实和 Case Draft 结果"
      ]
    },
    {
      "dot": "emerald",
      "title": "证据路径",
      "items": [
        "LangChain 负责 MiniMax 结构化意图、Prompt 和政策检索",
        "PostgreSQL 可承载 pgvector 政策集合与 LangGraph checkpoint",
        "FastMCP 只暴露订单、设备和维修状态查询"
      ]
    },
    {
      "dot": "rose",
      "title": "安全边界",
      "items": [
        "模型工具白名单不包含正式 Case 或 Work Order 写入",
        "Case Draft 由应用节点调用 Spring Boot 内部接口",
        "MVP 的 MCP 业务事实来自脱敏 Mock，不代表真实生产数据"
      ]
    }
  ]

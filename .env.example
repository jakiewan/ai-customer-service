# 复制为 .env 后按需修改；不要提交真实密钥。
GLOBALCARE_LLM_MODE=minimax
GLOBALCARE_MINIMAX_API_KEY=
GLOBALCARE_MINIMAX_BASE_URL=https://api.minimax.cn/v1
GLOBALCARE_MINIMAX_MODEL=MiniMax-M3
GLOBALCARE_LLM_ALLOW_FALLBACK=false
GLOBALCARE_EMBEDDING_MODE=huggingface
GLOBALCARE_EMBEDDING_MODEL=BAAI/bge-m3
GLOBALCARE_EMBEDDING_DIMENSIONS=1024
GLOBALCARE_POLICY_BACKEND=milvus
GLOBALCARE_MILVUS_URI=http://127.0.0.1:19530
GLOBALCARE_MILVUS_DB=ai_customer_service
GLOBALCARE_REDIS_URL=redis://127.0.0.1:56379/0
GLOBALCARE_PERSISTENCE_MODE=postgres
GLOBALCARE_CHECKPOINTER_MODE=postgres
GLOBALCARE_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55432/globalcare_agent
GLOBALCARE_BUSINESS_MODE=mock
GLOBALCARE_BUSINESS_BASE_URL=http://127.0.0.1:8081
GLOBALCARE_MCP_MODE=mock
GLOBALCARE_MCP_URL=http://127.0.0.1:8001/mcp
GLOBALCARE_MCP_TOKEN=
# 本地 file:// 页面会发送 Origin: null；生产环境请改成明确的 HTTPS 来源。
GLOBALCARE_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,null
GLOBALCARE_DEMO_TOKEN=globalcare-demo-token
# JWT 模式接入已有登录系统，不在此处填写或提交真实签名凭证。
GLOBALCARE_AUTH_MODE=jwt
GLOBALCARE_JWT_PUBLIC_KEY=
GLOBALCARE_JWT_ISSUER=
GLOBALCARE_JWT_AUDIENCE=
# 回环网页可由运行入口提供已有 JWT；Agent 不签发用户身份。
GLOBALCARE_WEB_ACCESS_TOKEN=
GLOBALCARE_AGENT_RUN_TIMEOUT_SECONDS=60
GLOBALCARE_MESSAGE_LOCK_TIMEOUT_SECONDS=5
GLOBALCARE_MAX_ACTIVE_RUNS=8
GLOBALCARE_POLICY_ALLOW_FALLBACK=false
GLOBALCARE_BUSINESS_TOKEN=
# 本地模拟 Java 没有 healthz，此处用已有只读接口探测；生产改为真实健康检查路径。
GLOBALCARE_BUSINESS_HEALTH_PATH=/internal/service-centers?market=CN
# production/staging 必须同时配置 JWT、持久化、语义 Embedding、严格检索、HTTPS 与服务凭证。
GLOBALCARE_ENVIRONMENT=local

# 官方入口：使用业务确认的 HTTPS 地址，未配置时返回不可用说明。
GLOBALCARE_PURCHASE_URL=
GLOBALCARE_AFTERSALES_URL=

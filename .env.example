# 复制为 .env 后按需修改；不要提交真实密钥。
GLOBALCARE_LLM_MODE=mock
GLOBALCARE_MINIMAX_API_KEY=
GLOBALCARE_MINIMAX_BASE_URL=https://api.minimax.chat/v1
GLOBALCARE_MINIMAX_MODEL=MiniMax-M3
GLOBALCARE_EMBEDDING_MODE=hash
GLOBALCARE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 使用上述 HuggingFace 模型时改为 384，并重新创建独立 pgvector collection。
GLOBALCARE_EMBEDDING_DIMENSIONS=256
GLOBALCARE_POLICY_BACKEND=memory
GLOBALCARE_PERSISTENCE_MODE=memory
GLOBALCARE_CHECKPOINTER_MODE=memory
GLOBALCARE_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/globalcare_agent
GLOBALCARE_BUSINESS_MODE=mock
GLOBALCARE_BUSINESS_BASE_URL=http://127.0.0.1:8081
GLOBALCARE_MCP_MODE=mock
GLOBALCARE_MCP_URL=http://127.0.0.1:8001/mcp
# 本地 file:// 页面会发送 Origin: null；生产环境请改成明确的 HTTPS 来源。
GLOBALCARE_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,null
GLOBALCARE_DEMO_TOKEN=globalcare-demo-token

# ──────────────────────────────────────────────
# 环境与密钥
# ──────────────────────────────────────────────
.env
.env.*
!.env.example

# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 测试 / 覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Linter / 类型检查
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# 虚拟环境
.venv/
venv/
env/
ENV/

# ──────────────────────────────────────────────
# Java / Maven
# ──────────────────────────────────────────────
domain_service/target/
domain_service/.mvn/repository/
*.class
*.jar
*.war
*.ear
hs_err_pid*

# ──────────────────────────────────────────────
# 前端 / Node
# ──────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.nuxt/
.cache/
.parcel-cache/

# ──────────────────────────────────────────────
# IDE / 编辑器
# ──────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws

# ──────────────────────────────────────────────
# OS / 日志
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.log
logs/

# 含个人信息的简历产物
experience/*.pdf
experience/*.docx

# 个人资料、求职记录和本机元数据仅保留在本地
/experience/
/.learnings/
/.vscode/
/本需求标识.md
**/*简历*
**/*resume*
**/*证件照*
/.history/*
*.jpg
*.png
*.svg
*.md
*.html

# 运行时政策资料需随代码交付，其余本地 Markdown 仍保留忽略规则。
!agent_service/data/policies/*.md
*/tests/*

